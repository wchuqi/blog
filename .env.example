# video-to-markdown skill 的凭据配置。
# 复制成 .env 后填入真实值；.env 已在 .gitignore 里，不会进版本库。
# 每次运行 skill 时会把这里的值同步进 dancer。

# ── 语音转文字（ASR）：二选一 ──
# 方案 A：SiliconFlow 云端（默认，需 API Key）
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=TeleAI/TeleSpeechASR

# 方案 B：本地 FunASR（需 pip install funasr，不联网，吃 CPU）
FUNASR_DEVICE=cpu

# ── LLM：把转写整理成 Markdown 笔记 ──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ── VL：图文作品的图片转文字 ──
VL_BASE_URL=https://api.siliconflow.cn/v1
VL_API_KEY=
VL_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# ── B 站登录态：配上才能拿到 1080P+ 与 CC 字幕（不配通常只有 480P）──
# 同样粘整行 Cookie 头。留空则沿用 dancer 里已保存的登录态。
BILIBILI_COOKIE=

# ── 可选：下载走代理 ──
PROXY_HTTP=
PROXY_HTTPS=
